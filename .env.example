# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx

# Backblaze B2 (S3-compatible API)
B2_REGION=us-west-004
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
B2_APPLICATION_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
B2_BUCKET_NAME=pad-ntt-lampiran

# Opsional -- hanya perlu diisi kalau bucket di-set Public di B2.
# Kalau bucket masih Private (default), biarkan kosong / hapus baris ini;
# aplikasi otomatis pakai presigned download URL (getDownloadUrl) sebagai gantinya.
# B2_PUBLIC_URL=https://f004.backblazeb2.com/file/pad-ntt-lampiran
